---
import {cx} from '../styles/ui';
import Icon from './Icon.astro';
import catalogue from '../../public/catalog.json';
const reportCount=catalogue.length.toLocaleString('en-US');
const decades=[1940,1950,1960,1970,1980,1990,2000,2010,2020];
const suggestions=['Geometric','Swiss typography','Warm colors','Minimalist','Photography','Paul Rand'];
---
<div id="app-splash" class={cx('splash')} role="status"><div class={cx('splashInner')}><span class={cx('splashBrand')}>annual</span><span class={cx('splashCaption')}>An archive of good design</span><span class={cx('splashTrack')}><span data-progress class={cx('splashProgress')}></span></span></div></div>
<a class="skip-link" href="#gallery">Skip to archive</a>
<header class:list={['masthead',cx('masthead')]}>
 <a class:list={['wordmark',cx('wordmark')]} href="/" aria-label="Annual Archive home"><svg class:list={['archive-symbol',cx('symbol')]} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" stroke="currentColor" stroke-width="1.5"/></svg><span>annual</span></a>
 <nav aria-label="Archive navigation" class={cx('nav')}><button id="about" class={cx('aboutButton')} aria-label="About the archive"><Icon name="info"/></button><button id="saved" class={cx('solidButton')} aria-pressed="false"><Icon name="bookmark"/><span>Collection</span><span id="saved-count" class={cx('savedCount')}>00</span></button></nav>
 <button id="open-search" class:list={['search-trigger',cx('searchTrigger')]} aria-keyshortcuts="Meta+K" aria-label="Search the archive"><Icon name="search"/><span class={cx('searchText')}>Search the archive</span><kbd class={cx('shortcut')}>⌘ K</kbd></button>
</header>
<main>
 <h1 class="sr-only">Annual Archive</h1>
 <section id="gallery" class:list={['gallery',cx('gallery')]} tabindex="0" aria-label="Infinite report canvas. Drag or use arrow keys to explore. Select a cover to read."></section>
 <section id="grid" class:list={['grid-view','hidden',cx('grid')]} aria-label="Report grid"></section>
 <div id="empty" class:list={['empty','hidden',cx('empty')]}><span class={cx('emptyTitle')}>Nothing here. Yet.</span><p class={cx('muted')}>Try a different company, decade, or design detail.</p><button class:list={['primary',cx('primary')]} id="empty-clear">Reset the archive <Icon name="arrow-right"/></button></div>
 <div class:list={['dock',cx('dock')]}><div class:list={['view-switch',cx('switch')]} aria-label="Gallery layout"><button id="canvas-view" class:list={['selected',cx('switchButton','selected')]} aria-label="Canvas view" aria-pressed="true"><Icon name="move"/><span>Canvas</span></button><button id="grid-view" class={cx('switchButton')} aria-label="Grid view" aria-pressed="false"><Icon name="grid-2x2"/><span>Grid</span></button></div><span class:list={['dock-line',cx('dockLine')]}></span><div class:list={['zoom-controls',cx('zoom')]}><button id="zoom-out" class={cx('zoomButton')} aria-label="Zoom out"><Icon name="minus"/></button><button id="zoom-value" class={cx('zoomButton','zoomValue')} aria-label="Reset canvas">100%</button><button id="zoom-in" class={cx('zoomButton')} aria-label="Zoom in"><Icon name="plus"/></button></div></div>
</main>
<dialog id="search-dialog" class:list={['search-dialog',cx('searchDialog')]} aria-label="Search the archive">
 <div class:list={['search-line',cx('searchLine')]}><Icon name="search"/><input id="search-input" class={cx('searchInput')} placeholder="A company, a style, a feeling…" aria-label="Search reports" autocomplete="off"/><button class:list={['icon-button',cx('iconButton')]} data-close="search-dialog" aria-label="Close search"><Icon name="x"/></button></div>
 <div class:list={['search-body',cx('searchBody')]}>
 <section class:list={['filterbar',cx('filterbar')]} aria-label="Filter archive"><div class:list={['filter-left',cx('filterLeft')]}><span id="result-count" class={cx('resultCount')} aria-live="polite">{reportCount} artifacts</span><label class:list={['select-wrap',cx('selectWrap')]}><select id="decade" class={cx('select')} aria-label="Decade"><option value="">All decades</option>{decades.map(d=><option value={d}>{d}s</option>)}</select><Icon name="chevron-down"/></label><label class:list={['select-wrap',cx('selectWrap')]}><select id="industry" class={cx('select')} aria-label="Industry"><option value="">All industries</option></select><Icon name="chevron-down"/></label><label class:list={['select-wrap',cx('selectWrap')]}><select id="color" class={cx('select')} aria-label="Color"><option value="">Any color</option>{['red','orange','yellow','green','blue','neutral'].map(c=><option value={c}>{c}</option>)}</select><Icon name="chevron-down"/></label><button id="clear" class:list={['clear','hidden',cx('clear')]}>Clear filters <Icon name="x"/></button></div></section>
 <div class:list={['eyebrow',cx('eyebrow')]}>FOLLOW YOUR CURIOSITY</div><div class:list={['suggestions',cx('suggestions')]}>{suggestions.map(t=><button class={cx('suggestion')} data-search={t}>{t}<Icon name="arrow-up-right"/></button>)}</div><div class={cx('switch')} aria-label="Search scope"><button id="search-reports" class={cx('switchButton','selected')} aria-pressed="true">Reports</button><button id="search-pages" class={cx('switchButton')} aria-pressed="false">Pages &amp; design</button></div><div id="page-search-results" class="hidden" aria-label="Matching pages"></div><p id="search-count" class={cx('muted')} role="status">Search all {reportCount} artifacts</p><button id="search-done" class:list={['primary',cx('primary','searchDone')]}>Explore results <Icon name="arrow-right"/></button>
 </div>
</dialog>
<dialog id="about-dialog" class:list={['about-dialog',cx('aboutDialog')]} aria-label="About Annual Archive"><button class:list={['icon-button','dialog-close',cx('iconButton','close')]} data-close="about-dialog" aria-label="Close about"><Icon name="x"/></button><div class:list={['eyebrow',cx('eyebrow')]}>ANNUAL ARCHIVE</div><h2 class={cx('aboutTitle')}>Even business had an art department.</h2><p class={cx('aboutText')}>For decades, the annual report was a canvas for extraordinary graphic design. Explore the covers, unfold the pages, and collect what catches your eye.</p><div class:list={['about-stats',cx('stats')]}><span class={cx('stat')}><strong class={cx('statValue')}>{reportCount}</strong>artifacts</span><span class={cx('stat')}><strong class={cx('statValue')}>1945–2023</strong>years of design</span></div><p class:list={['source-note',cx('sourceNote')]}>Original catalogue and covers from <a href="https://annualreport.gallery/" target="_blank" rel="noreferrer">Annual Report Archive by Phil Hedayatnia ↗</a>. Additional reports from the <a href="https://library.columbia.edu/libraries/business/corpreports.html" target="_blank" rel="noreferrer">Columbia University Libraries ↗</a>. Rights remain with their respective owners. Full pages are available when the source provides public scans or a PDF. Your collection is saved in this browser.</p></dialog>
<dialog id="reader" class:list={['reader',cx('reader')]} aria-label="Report reading room">
 <header class:list={['reader-header',cx('readerHeader')]}><button id="close-reader" class={cx('readerBack')}><Icon name="arrow-left"/><span>Back to archive</span></button><button id="report-details" class={cx('detailsButton')} aria-label="Report information" aria-expanded="false"><Icon name="info"/></button><button id="save-report" class={cx('solidButton')}><Icon name="bookmark"/>Save report</button></header>
 <div class:list={['reader-body',cx('readerBody')]}><aside class:list={['report-info',cx('info')]} id="report-info"></aside><section class:list={['report-stage',cx('stage')]}><div id="page-canvas" class:list={['page-canvas',cx('pageCanvas')]} tabindex="0" aria-label="Report pages canvas. Drag or use arrow keys to browse."></div><div id="report-status" class:list={['report-status',cx('status')]} role="status"></div><div class:list={['reader-dock',cx('readerDock')]}><div class:list={['view-switch',cx('switch')]}><button id="strip-mode" class={cx('switchButton')}><Icon name="book-open"/>Scroll</button><button id="pages-mode" class:list={['selected',cx('switchButton','selected')]}><Icon name="grid-2x2"/>All pages</button><button id="read-mode" class={cx('switchButton')}><Icon name="book-open"/>Read</button></div><span class:list={['dock-line',cx('dockLine')]}></span><div id="page-navigation" class={cx('pageNavigation')}><button id="prev-page" class={cx('navButton')} aria-label="Previous page"><Icon name="arrow-left"/></button><span id="page-number" class={cx('pageNumber')}>—</span><button id="next-page" class={cx('navButton')} aria-label="Next page"><Icon name="arrow-right"/></button></div><div id="page-zoom" class={cx('pageNavigation')}><button id="page-minus" class={cx('navButton')} aria-label="Zoom out pages"><Icon name="minus"/></button><button id="page-reset" class={cx('pageNumber','navButton')} aria-label="Reset pages canvas">100%</button><button id="page-plus" class={cx('navButton')} aria-label="Zoom in pages"><Icon name="plus"/></button></div></div></section></div>
</dialog>
<div id="toast" class:list={['toast',cx('toast')]} role="status"></div>
